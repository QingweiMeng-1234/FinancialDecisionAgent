{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "theme-chokepoint-stage4-v1.5",
  "title": "Theme Chokepoint v1.5 Stage 4 boundary",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "status", "challenger_sets", "company_assessments", "incomplete_reasons"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPANY_ASSESSMENT_READY", "COMPANY_ASSESSMENT_INCOMPLETE"]},
    "incomplete_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "challenger_sets": {"type": "array", "items": {"$ref": "#/$defs/challenger_set"}},
    "company_assessments": {"type": "array"},
    "company_claims": {"type": "array", "items": {"$ref": "#/$defs/rebound_claim"}},
    "company_evidence_cards": {"type": "array", "items": {"$ref": "#/$defs/rebound_card"}}
  },
  "$defs": {
    "assessment_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "product_id", "segment_id", "customer_or_platform_scope", "geography", "time_horizon_months", "as_of_date"],
      "properties": {
        "company_id": {"type": ["string", "null"]},
        "product_id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "customer_or_platform_scope": {"type": "string", "minLength": 1},
        "geography": {"type": "string", "minLength": 1},
        "time_horizon_months": {"type": "integer", "exclusiveMinimum": 0},
        "as_of_date": {"type": "string", "format": "date"}
      }
    },
    "challenger_set": {
      "type": "object",
      "required": ["challenger_set_id", "segment_id", "assessment_scope", "included_assessment_ids", "excluded_candidates_with_reason", "coverage_gate", "counter_search_receipt"],
      "properties": {
        "challenger_set_id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "assessment_scope": {"$ref": "#/$defs/assessment_scope"},
        "included_company_ids": {"type": "array", "maxItems": 0},
        "included_assessment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded_candidates_with_reason": {"type": "array"},
        "coverage_gate": {"type": "boolean"},
        "counter_search_receipt": {"type": ["object", "null"]}
      }
    },
    "rebound_claim": {
      "type": "object",
      "required": ["claim_id", "assessment_scope", "subject_company_ids", "derived_from_evidence_id"],
      "properties": {
        "claim_id": {"type": "string"},
        "assessment_scope": {"$ref": "#/$defs/assessment_scope"},
        "subject_company_ids": {"type": "array", "items": {"type": "string"}},
        "derived_from_evidence_id": {"type": ["string", "null"]}
      }
    },
    "rebound_card": {
      "type": "object",
      "required": ["evidence_id", "assessment_scope", "source_identity_id", "source_version_id", "derived_from_evidence_id"],
      "properties": {
        "evidence_id": {"type": "string"},
        "assessment_scope": {"$ref": "#/$defs/assessment_scope"},
        "source_identity_id": {"type": "string"},
        "source_version_id": {"type": "string"},
        "derived_from_evidence_id": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPANY_ASSESSMENT_READY"}}},
      "then": {"properties": {"incomplete_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "COMPANY_ASSESSMENT_INCOMPLETE"}}},
      "then": {"properties": {"incomplete_reasons": {"minItems": 1}}}
    }
  ]
}
