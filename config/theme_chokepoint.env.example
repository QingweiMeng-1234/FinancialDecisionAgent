# Required for Tavily URL discovery. Search summaries are discovery-only.
TAVILY_API_KEY=

# Theme evidence extraction is pinned to DeepSeek. The dedicated key is optional;
# when it is empty, the provider selector reads DEEPSEEK_API_KEY directly.
DEEPSEEK_API_KEY=
THEME_CHOKEPOINT_LLM_PROVIDER=deepseek
THEME_CHOKEPOINT_LLM_API_KEY=
THEME_CHOKEPOINT_LLM_BASE_URL=https://api.deepseek.com
THEME_CHOKEPOINT_LLM_MODEL=deepseek-chat
