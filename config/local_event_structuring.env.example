# Opt-in, event-extraction-only settings. Never replace DEEPSEEK_BASE_URL.
EVENT_STRUCTURING_PROVIDER=local
LOCAL_EVENT_BASE_URL=http://127.0.0.1:18081/v1
LOCAL_EVENT_MODEL=financial-event-qwen-1.5b-q4
LOCAL_EVENT_TIMEOUT_SECONDS=120
LOCAL_EVENT_MAX_INPUT_CHARS=12000
LOCAL_EVENT_MAX_OUTPUT_TOKENS=1536
# Optional only if your loopback server requires authentication:
# LOCAL_EVENT_API_KEY=
# To allow existing DeepSeek configuration as lazy fallback:
# EVENT_STRUCTURING_PROVIDER=local_with_fallback
